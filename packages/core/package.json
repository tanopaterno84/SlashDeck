{
  "name": "@slashdeck/core",
  "version": "0.1.0",
  "private": true,
  "description": "SlashDeck core: discovers Claude Code slash commands and builds the catalog.",
  "type": "module",
  "bin": {
    "slashdeck": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "dev": "tsx src/dev.ts",
    "test": "vitest run",
    "lint": "eslint . && prettier --check ."
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2"
  }
}
